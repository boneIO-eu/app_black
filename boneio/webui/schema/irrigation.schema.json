{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "irrigation": {
      "type": [
        "array",
        "string"
      ],
      "items": {
        "type": [
          "object",
          "string"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of I2C to use in pin config",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "description": "Display name for the irrigation controller in Home Assistant.",
            "title": "Name"
          },
          "master_valve": {
            "type": "string",
            "description": "Output ID of the master valve (pump). Turned on before any zone opens.",
            "title": "Master valve"
          },
          "standby": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": false,
            "description": "When enabled, the controller will not start any valves.",
            "title": "Standby"
          },
          "valve_open_delay": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Delay between valve switching. May not be used with valve_overlap.",
            "title": "Valve open delay"
          },
          "valve_overlap": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Time that current and next valve run simultaneously. May not be used with valve_open_delay.",
            "title": "Valve overlap"
          },
          "pump_switch_off_during_valve_open_delay": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": false,
            "description": "Turn off pump during valve_open_delay interval.",
            "title": "Pump switch off during valve open delay"
          },
          "pump_start_pump_delay": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Delay from valve open to pump activation. May not be used with pump_start_valve_delay.",
            "title": "Pump start pump delay"
          },
          "pump_start_valve_delay": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Delay from pump start to valve open. May not be used with pump_start_pump_delay.",
            "title": "Pump start valve delay"
          },
          "pump_stop_pump_delay": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Delay from valve close to pump deactivation. May not be used with pump_stop_valve_delay.",
            "title": "Pump stop pump delay"
          },
          "pump_stop_valve_delay": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Delay from pump deactivation to valve close. May not be used with pump_stop_pump_delay.",
            "title": "Pump stop valve delay"
          },
          "multiplier": {
            "type": [
              "number",
              "string"
            ],
            "default": 1.0,
            "description": "Duration multiplier applied to all zone run times. 1.0 = 100%.",
            "title": "Multiplier"
          },
          "repeat": {
            "type": [
              "integer",
              "string"
            ],
            "default": 0,
            "description": "Number of times to repeat the full cycle. 0 = run once.",
            "title": "Repeat"
          },
          "auto_advance": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": true,
            "description": "Automatically advance to the next zone. Disable for single-zone manual mode.",
            "title": "Auto advance"
          },
          "reverse": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": false,
            "description": "Run zones in reverse order.",
            "title": "Reverse"
          },
          "schedule": {
            "type": [
              "array",
              "string"
            ],
            "items": {
              "type": [
                "object",
                "string"
              ],
              "properties": {
                "time": {
                  "type": "string",
                  "description": "Start time in HH:MM format. Example: 06:00.",
                  "title": "Time"
                },
                "days": {
                  "type": "string",
                  "default": "daily",
                  "enum": [
                    "daily",
                    "weekdays",
                    "weekend",
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat",
                    "sun"
                  ],
                  "examples": [
                    "daily"
                  ],
                  "description": "Days when this schedule is active.",
                  "title": "Days"
                }
              },
              "required": [
                "time"
              ]
            },
            "description": "Scheduled start times for this controller.",
            "title": "Schedule"
          },
          "zones": {
            "type": [
              "array",
              "string"
            ],
            "items": {
              "type": [
                "object",
                "string"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Id of I2C to use in pin config",
                  "title": "Id"
                },
                "name": {
                  "type": "string",
                  "description": "Display name for the zone.",
                  "title": "Name"
                },
                "valve_id": {
                  "type": "string",
                  "description": "Output ID of the valve relay to control.",
                  "title": "Valve id"
                },
                "run_duration": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "x-timeperiod": true,
                  "description": "How long to run this zone. Example 5min or 300s.",
                  "title": "Run duration"
                },
                "enabled": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "true",
                        "false",
                        "on",
                        "off"
                      ],
                      "x-yaml-boolean": true
                    }
                  ],
                  "default": true,
                  "description": "Whether this zone is active.",
                  "title": "Enabled"
                },
                "run_every": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "x-timeperiod": true,
                  "description": "Minimum interval between runs. Example 1d, 2d, 3d.",
                  "title": "Run every"
                }
              },
              "required": [
                "valve_id",
                "run_duration"
              ]
            },
            "description": "Irrigation zones \u2014 each zone controls a single valve output.",
            "title": "Zones"
          }
        },
        "required": [
          "zones"
        ]
      },
      "description": "Irrigation controllers \u2014 manage watering zones with schedules, per-zone intervals, and master valve support.",
      "title": "Irrigation"
    }
  }
}