{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ina226": {
      "description": "INA226 Power monitor (boneIO Black v1.0). Measures board current, voltage and power. Replaces INA219 on v1.0 boards.",
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of I2C to use in pin config",
            "title": "Id"
          },
          "address": {
            "default": 64,
            "description": "Address of I2C",
            "type": [
              "integer",
              "string"
            ],
            "title": "Address"
          },
          "sensors": {
            "default": [
              {
                "id": "Board Current",
                "device_class": "current",
                "filters": [
                  {
                    "round": 2
                  }
                ]
              },
              {
                "id": "Board Power",
                "device_class": "power",
                "filters": [
                  {
                    "round": 2
                  }
                ]
              },
              {
                "id": "Board Voltage",
                "device_class": "voltage",
                "filters": [
                  {
                    "round": 2
                  }
                ]
              }
            ],
            "items": {
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Id of I2C to use in pin config",
                  "title": "Id"
                },
                "device_class": {
                  "enum": [
                    "current",
                    "power",
                    "voltage"
                  ],
                  "type": "string"
                },
                "filters": {
                  "default": [
                    {
                      "round": 2
                    }
                  ],
                  "description": "List of filters to apply. Allowed filters visible in allowed section.",
                  "items": {
                    "additionalProperties": true,
                    "propertyNames": {
                      "enum": [
                        "offset",
                        "round",
                        "multiply",
                        "filter_out",
                        "filter_out_greater",
                        "filter_out_lower"
                      ]
                    },
                    "type": [
                      "object",
                      "string"
                    ]
                  },
                  "type": [
                    "array",
                    "string"
                  ],
                  "title": "Filters"
                }
              },
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "array",
              "string"
            ]
          },
          "update_interval": {
            "default": "60s",
            "description": "Update interval. How often to fetch data from sensor. Default to 60s.",
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "title": "Update interval"
          }
        },
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Ina226"
    }
  }
}