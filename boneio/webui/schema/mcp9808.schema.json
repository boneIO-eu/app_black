{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mcp9808": {
      "description": "https://boneio.eu/docs/black/configuration/mcp9808 \n MCP9808 Sensor list. Older boneIO Black had one MCP9808 instead of LM75on board, which measures temperature.",
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of I2C to use in pin config",
            "title": "Id"
          },
          "address": {
            "default": 24,
            "description": "Address of I2C device",
            "type": [
              "integer",
              "string"
            ],
            "title": "Address"
          },
          "update_interval": {
            "default": "60s",
            "description": "Update interval. How often to fetch data from sensor. Default to 60s.",
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "title": "Update interval"
          },
          "filters": {
            "default": [
              {
                "round": 2
              }
            ],
            "description": "List of filters to apply. Allowed filters visible in allowed section.",
            "items": {
              "additionalProperties": true,
              "propertyNames": {
                "enum": [
                  "offset",
                  "round",
                  "multiply",
                  "filter_out",
                  "filter_out_greater",
                  "filter_out_lower"
                ]
              },
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "array",
              "string"
            ],
            "title": "Filters"
          },
          "unit_of_measurement": {
            "default": "\u00b0C",
            "enum": [
              "\u00b0C",
              "\u00b0F"
            ],
            "type": "string"
          }
        },
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Mcp9808"
    }
  }
}