{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "template": {
      "type": [
        "array",
        "string"
      ],
      "items": {
        "type": [
          "object",
          "string"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of I2C to use in pin config",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "description": "Display name for the entity in Home Assistant.",
            "title": "Name"
          },
          "platform": {
            "type": "string",
            "enum": [
              "thermostat",
              "alarm_control_panel",
              "gate_cover"
            ],
            "examples": [
              "thermostat"
            ],
            "description": "Template platform type.",
            "title": "Platform"
          },
          "area": {
            "type": "string",
            "description": "Area/room for HA device grouping.",
            "title": "Area"
          },
          "sensor_id": {
            "type": "string",
            "description": "ID of the primary temperature sensor (thermostat only).",
            "title": "Sensor id"
          },
          "sensor_ids": {
            "type": [
              "array",
              "string"
            ],
            "description": "List of temperature sensor IDs. Average of available readings is used (thermostat only).",
            "title": "Sensor ids"
          },
          "output_id": {
            "type": "string",
            "description": "ID of the output (relay) to control (thermostat only).",
            "title": "Output id"
          },
          "mode": {
            "type": "string",
            "default": "heat",
            "enum": [
              "heat",
              "off"
            ],
            "examples": [
              "heat"
            ],
            "description": "Initial climate mode (thermostat only).",
            "title": "Mode"
          },
          "target_temperature": {
            "type": [
              "number",
              "string"
            ],
            "default": 21.0,
            "description": "Initial target temperature in \u00b0C (thermostat only).",
            "title": "Target temperature"
          },
          "hysteresis": {
            "type": [
              "number",
              "string"
            ],
            "default": 0.5,
            "description": "Temperature hysteresis in \u00b0C (thermostat only).",
            "title": "Hysteresis"
          },
          "min_temperature": {
            "type": [
              "number",
              "string"
            ],
            "default": 5.0,
            "description": "Minimum settable temperature (thermostat only).",
            "title": "Min temperature"
          },
          "max_temperature": {
            "type": [
              "number",
              "string"
            ],
            "default": 35.0,
            "description": "Maximum settable temperature (thermostat only).",
            "title": "Max temperature"
          },
          "codes": {
            "type": [
              "array",
              "string"
            ],
            "items": {
              "type": [
                "object",
                "string"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "User name (used in logs to identify who disarmed).",
                  "title": "Name"
                },
                "code": {
                  "type": "string",
                  "description": "Numeric PIN code.",
                  "title": "Code"
                }
              },
              "required": [
                "name",
                "code"
              ]
            },
            "description": "List of PIN codes with user names for arming/disarming the alarm.",
            "title": "Codes"
          },
          "code_arm_required": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": false,
            "description": "Whether code is required to arm the alarm.",
            "title": "Code arm required"
          },
          "arming_time": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Time before alarm is armed after arming command. Example 30s.",
            "title": "Arming time"
          },
          "delay_time": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Entry delay time before alarm triggers. Example 30s.",
            "title": "Delay time"
          },
          "trigger_time": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Duration the alarm stays triggered. Example 5min.",
            "title": "Trigger time"
          },
          "outputs": {
            "type": [
              "array",
              "string"
            ],
            "items": {
              "type": [
                "object",
                "string"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Output relay ID.",
                  "title": "Id"
                },
                "type": {
                  "type": "string",
                  "default": "siren",
                  "enum": [
                    "siren",
                    "notification",
                    "light",
                    "custom"
                  ],
                  "examples": [
                    "siren"
                  ],
                  "description": "Output type (siren, notification, light, custom).",
                  "title": "Type"
                }
              },
              "required": [
                "id"
              ]
            },
            "description": "List of outputs activated when alarm triggers.",
            "title": "Outputs"
          },
          "zones": {
            "type": [
              "array",
              "string"
            ],
            "items": {
              "type": [
                "object",
                "string"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Zone name.",
                  "title": "Name"
                },
                "inputs": {
                  "type": [
                    "array",
                    "string"
                  ],
                  "description": "List of input IDs monitored in this zone.",
                  "title": "Inputs"
                },
                "arm_modes": {
                  "type": [
                    "array",
                    "string"
                  ],
                  "description": "Arm modes where this zone is active (armed_away, armed_home, armed_night).",
                  "title": "Arm modes"
                },
                "entry_delay": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "true",
                        "false",
                        "on",
                        "off"
                      ],
                      "x-yaml-boolean": true
                    }
                  ],
                  "default": false,
                  "description": "Whether this zone uses entry delay before triggering.",
                  "title": "Entry delay"
                }
              },
              "required": [
                "name",
                "inputs",
                "arm_modes"
              ]
            },
            "description": "Alarm zones \u2014 groups of inputs with arm mode assignments.",
            "title": "Zones"
          },
          "control_mode": {
            "type": "string",
            "default": "cycle",
            "enum": [
              "cycle",
              "separate",
              "open_only"
            ],
            "examples": [
              "cycle"
            ],
            "description": "Gate control mode (gate_cover only).",
            "title": "Control mode"
          },
          "device_class": {
            "type": "string",
            "default": "gate",
            "enum": [
              "gate",
              "garage_door",
              "barrier",
              "door"
            ],
            "examples": [
              "gate"
            ],
            "description": "HA device class for the cover entity (gate_cover only).",
            "title": "Device class"
          },
          "pulse_output": {
            "type": "string",
            "description": "Relay output ID for pulse control (cycle/open_only modes).",
            "title": "Pulse output"
          },
          "open_output": {
            "type": "string",
            "description": "Relay output ID for opening (separate mode).",
            "title": "Open output"
          },
          "close_output": {
            "type": "string",
            "description": "Relay output ID for closing (separate mode).",
            "title": "Close output"
          },
          "stop_output": {
            "type": "string",
            "description": "Relay output ID for stop (separate mode, optional).",
            "title": "Stop output"
          },
          "pulse_duration": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "How long the relay pulse lasts. Example 500ms.",
            "title": "Pulse duration"
          },
          "closed_sensor": {
            "type": "string",
            "description": "Input ID of the closed contact sensor.",
            "title": "Closed sensor"
          },
          "open_sensor": {
            "type": "string",
            "description": "Input ID of the open contact sensor.",
            "title": "Open sensor"
          }
        },
        "required": [
          "platform"
        ]
      },
      "description": "Template entities \u2014 composite virtual entities like thermostats and alarm panels.",
      "title": "Template"
    }
  }
}