{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "template": {
      "description": "Template entities \u2014 composite virtual entities like thermostats and alarm panels.",
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of I2C to use in pin config",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "description": "Display name for the entity in Home Assistant.",
            "title": "Name"
          },
          "platform": {
            "description": "Template platform type.",
            "enum": [
              "thermostat",
              "alarm_control_panel",
              "gate_cover",
              "irrigation"
            ],
            "type": "string",
            "title": "Platform"
          },
          "area": {
            "type": "string",
            "description": "Area/room for HA device grouping.",
            "title": "Area"
          },
          "sensor_id": {
            "type": "string",
            "description": "ID of the primary temperature sensor (thermostat only).",
            "title": "Sensor id"
          },
          "sensor_ids": {
            "type": [
              "array",
              "string"
            ],
            "description": "List of temperature sensor IDs. Average of available readings is used (thermostat only).",
            "title": "Sensor ids"
          },
          "output_id": {
            "type": "string",
            "description": "ID of the output (relay) to control (thermostat only).",
            "title": "Output id"
          },
          "mode": {
            "default": "heat",
            "description": "Initial climate mode (thermostat only).",
            "enum": [
              "heat",
              "off"
            ],
            "type": "string",
            "title": "Mode"
          },
          "target_temperature": {
            "default": 21.0,
            "description": "Initial target temperature in \u00b0C (thermostat only).",
            "type": [
              "integer",
              "number",
              "string"
            ],
            "title": "Target temperature"
          },
          "hysteresis": {
            "default": 0.5,
            "description": "Temperature hysteresis in \u00b0C (thermostat only).",
            "type": [
              "integer",
              "number",
              "string"
            ],
            "title": "Hysteresis"
          },
          "min_temperature": {
            "default": 5.0,
            "description": "Minimum settable temperature (thermostat only).",
            "type": [
              "integer",
              "number",
              "string"
            ],
            "title": "Min temperature"
          },
          "max_temperature": {
            "default": 35.0,
            "description": "Maximum settable temperature (thermostat only).",
            "type": [
              "integer",
              "number",
              "string"
            ],
            "title": "Max temperature"
          },
          "codes": {
            "items": {
              "properties": {
                "name": {
                  "description": "User name (used in logs to identify who disarmed).",
                  "type": "string",
                  "title": "Name"
                },
                "code": {
                  "description": "Numeric PIN code (digits only), or its SHA-256 hash.",
                  "pattern": "^([0-9]+|[0-9a-fA-F]{64})$",
                  "type": "string",
                  "title": "Code"
                }
              },
              "required": [
                "name",
                "code"
              ],
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "array",
              "string"
            ],
            "description": "List of PIN codes with user names for arming/disarming the alarm.",
            "title": "Codes"
          },
          "code_arm_required": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": false,
            "description": "Whether code is required to arm the alarm.",
            "title": "Code arm required"
          },
          "arming_time": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Time before alarm is armed after arming command. Example 30s.",
            "title": "Arming time"
          },
          "delay_time": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Entry delay time before alarm triggers. Example 30s.",
            "title": "Delay time"
          },
          "trigger_time": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Duration the alarm stays triggered. Example 5min.",
            "title": "Trigger time"
          },
          "outputs": {
            "items": {
              "properties": {
                "id": {
                  "description": "Output relay ID.",
                  "type": "string",
                  "title": "Id"
                },
                "type": {
                  "default": "siren",
                  "description": "Output type (siren, notification, light, custom).",
                  "enum": [
                    "siren",
                    "notification",
                    "light",
                    "custom"
                  ],
                  "type": "string",
                  "title": "Type"
                }
              },
              "required": [
                "id"
              ],
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "array",
              "string"
            ],
            "description": "List of outputs activated when alarm triggers.",
            "title": "Outputs"
          },
          "zones": {
            "items": {
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Zone name.",
                  "title": "Name"
                },
                "inputs": {
                  "type": [
                    "array",
                    "string"
                  ],
                  "description": "List of input IDs monitored in this zone (alarm_control_panel only).",
                  "title": "Inputs"
                },
                "arm_modes": {
                  "type": [
                    "array",
                    "string"
                  ],
                  "description": "Arm modes where this zone is active (alarm_control_panel only).",
                  "title": "Arm modes"
                },
                "entry_delay": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "true",
                        "false",
                        "on",
                        "off"
                      ],
                      "x-yaml-boolean": true
                    }
                  ],
                  "default": false,
                  "description": "Whether this zone uses entry delay before triggering (alarm_control_panel only).",
                  "title": "Entry delay"
                },
                "id": {
                  "type": "string",
                  "description": "Id of I2C to use in pin config",
                  "title": "Id"
                },
                "valve_id": {
                  "type": "string",
                  "description": "Output ID of the valve relay to control (irrigation only).",
                  "title": "Valve id"
                },
                "run_duration": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "x-timeperiod": true,
                  "description": "How long to run this zone (irrigation only). Example 5min.",
                  "title": "Run duration"
                },
                "enabled": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "true",
                        "false",
                        "on",
                        "off"
                      ],
                      "x-yaml-boolean": true
                    }
                  ],
                  "default": true,
                  "description": "Whether this zone is active (irrigation only).",
                  "title": "Enabled"
                },
                "run_every_n": {
                  "default": 1,
                  "description": "Run zone every Nth scheduled cycle. 1 = every time (irrigation only).",
                  "minimum": 1,
                  "type": [
                    "integer",
                    "string"
                  ],
                  "title": "Run every n"
                }
              },
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "array",
              "string"
            ],
            "description": "Zones \u2014 alarm zones or irrigation zones depending on platform.",
            "title": "Zones"
          },
          "control_mode": {
            "default": "cycle",
            "description": "Gate control mode (gate_cover only).",
            "enum": [
              "cycle",
              "separate",
              "open_only"
            ],
            "type": "string",
            "title": "Control mode"
          },
          "device_class": {
            "default": "gate",
            "description": "HA device class for the cover entity (gate_cover only).",
            "enum": [
              "gate",
              "garage_door",
              "barrier",
              "door"
            ],
            "type": "string",
            "title": "Device class"
          },
          "pulse_output": {
            "type": "string",
            "description": "Relay output ID for pulse control (cycle/open_only modes).",
            "title": "Pulse output"
          },
          "open_output": {
            "type": "string",
            "description": "Relay output ID for opening (separate mode).",
            "title": "Open output"
          },
          "close_output": {
            "type": "string",
            "description": "Relay output ID for closing (separate mode).",
            "title": "Close output"
          },
          "stop_output": {
            "type": "string",
            "description": "Relay output ID for stop (separate mode, optional).",
            "title": "Stop output"
          },
          "pulse_duration": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "How long the relay pulse lasts. Example 500ms.",
            "title": "Pulse duration"
          },
          "closed_sensor": {
            "type": "string",
            "description": "Input ID of the closed contact sensor.",
            "title": "Closed sensor"
          },
          "open_sensor": {
            "type": "string",
            "description": "Input ID of the open contact sensor.",
            "title": "Open sensor"
          },
          "water_sources": {
            "items": {
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Id of I2C to use in pin config",
                  "title": "Id"
                },
                "name": {
                  "type": "string",
                  "description": "Display name for the water source.",
                  "title": "Name"
                },
                "outputs": {
                  "description": "Output IDs to activate when this water source is used.",
                  "type": [
                    "array",
                    "string"
                  ],
                  "title": "Outputs"
                },
                "output_start_delay": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "x-timeperiod": true,
                  "description": "Delay between activating each output (sequential ON, in order).",
                  "title": "Output start delay"
                },
                "output_stop_delay": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "x-timeperiod": true,
                  "description": "Delay between deactivating each output (sequential OFF, reverse order).",
                  "title": "Output stop delay"
                },
                "pump_switch_off_during_valve_open_delay": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "true",
                        "false",
                        "on",
                        "off"
                      ],
                      "x-yaml-boolean": true
                    }
                  ],
                  "default": false,
                  "description": "Turn off source outputs during valve_open_delay interval.",
                  "title": "Pump switch off during valve open delay"
                },
                "pump_start_pump_delay": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "x-timeperiod": true,
                  "description": "Delay from valve open to source activation.",
                  "title": "Pump start pump delay"
                },
                "pump_start_valve_delay": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "x-timeperiod": true,
                  "description": "Delay from source activation to valve open.",
                  "title": "Pump start valve delay"
                },
                "pump_stop_pump_delay": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "x-timeperiod": true,
                  "description": "Delay from valve close to source deactivation.",
                  "title": "Pump stop pump delay"
                },
                "pump_stop_valve_delay": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "x-timeperiod": true,
                  "description": "Delay from source deactivation to valve close.",
                  "title": "Pump stop valve delay"
                }
              },
              "required": [
                "outputs"
              ],
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "array",
              "string"
            ],
            "description": "Water sources \u2014 each defines outputs to activate and per-source pump timing (irrigation only).",
            "title": "Water sources"
          },
          "standby": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": false,
            "description": "When enabled, the controller will not start any valves (irrigation only).",
            "title": "Standby"
          },
          "valve_open_delay": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Delay between valve switching (irrigation only). Example 2s.",
            "title": "Valve open delay"
          },
          "valve_overlap": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Time that current and next valve run simultaneously (irrigation only).",
            "title": "Valve overlap"
          },
          "multiplier": {
            "default": 1.0,
            "description": "Duration multiplier for all zone run times (irrigation only).",
            "type": [
              "integer",
              "number",
              "string"
            ],
            "title": "Multiplier"
          },
          "repeat": {
            "default": 0,
            "description": "Number of times to repeat the full cycle (irrigation only).",
            "type": [
              "integer",
              "string"
            ],
            "title": "Repeat"
          },
          "auto_advance": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": true,
            "description": "Auto-advance to next zone (irrigation only).",
            "title": "Auto advance"
          },
          "reverse": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": false,
            "description": "Run zones in reverse order (irrigation only).",
            "title": "Reverse"
          },
          "pause_timeout": {
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "description": "Auto-shutdown after being paused for this duration (irrigation only). Default 30min. Set 0 to disable.",
            "title": "Pause timeout"
          },
          "schedule": {
            "items": {
              "properties": {
                "time": {
                  "description": "Start time in HH:MM format. Example: 06:00.",
                  "type": "string",
                  "title": "Time"
                },
                "days": {
                  "default": "daily",
                  "description": "Days when this schedule is active.",
                  "enum": [
                    "daily",
                    "weekdays",
                    "weekend",
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat",
                    "sun"
                  ],
                  "type": "string",
                  "title": "Days"
                }
              },
              "required": [
                "time"
              ],
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "array",
              "string"
            ],
            "description": "Scheduled start times (irrigation only).",
            "title": "Schedule"
          }
        },
        "required": [
          "platform"
        ],
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Template"
    }
  }
}