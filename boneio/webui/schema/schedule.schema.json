            "type": "string",
            "default": "skip",
            "enum": [
              "skip",
              "run"
            ],
            "examples": [
              "skip"
            ],
            "description": "What to do about a firing missed while the device was off.",
            "title": "On missed"
          },
          "catch_up": {
            "type": [
              "number",
              "string"
            ],
            "default": 900,
            "description": "How late a missed firing may still run (on_missed - run).",
            "title": "Catch up"
          },
          "condition": {
            "type": [
              "object",
              "string"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "time",
                  "date",
                  "state",
                  "sun"
                ],
                "examples": [
                  "time"
                ],
                "description": "Condition type",
                "title": "Type"
              },
              "after": {
                "type": "string",
