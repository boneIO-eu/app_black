        "array",
        "string"
      ],
      "items": {
        "type": [
          "object",
          "string"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "description": "What this schedule is for.",
            "title": "Description"
          },
          "id": {
            "type": "string",
            "description": "Identifier, if the one made from the name will not do.",
            "title": "Id"
          },
          "enabled": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": true,
            "description": "Whether this schedule is armed.",
            "title": "Enabled"
          },
          "trigger": {
            "type": [
              "object",
              "string"
            ],
            "properties": {
              "type": {
                "type": "string",
                "default": "sun",
                "enum": [
                  "sun",
                  "time"
                ],
                "examples": [
                  "sun"
                ],
                "description": "Trigger type",
                "title": "Type"
              },
              "event": {
                "type": "string",
                "description": "Sun event (sun triggers only)",
                "title": "Event"
              },
              "at": {
                "type": "string",
                "description": "Clock time in HH:MM (time triggers only)",
                "title": "At"
              },
              "offset": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "Shift the moment",
                "title": "Offset"
              },
              "earliest": {
                "type": "string",
                "description": "Not before this clock time (sun triggers only)",
                "title": "Earliest"
              },
              "latest": {
                "type": "string",
                "description": "Not after this clock time (sun triggers only)",
                "title": "Latest"
              },
              "jitter": {
                "type": [
                  "number",
                  "string"
                ],
                "default": 0,
                "description": "Random spread",
                "title": "Jitter"
              },
              "days": {
                "type": "string",
                "default": "daily",
                "enum": [
                  "daily",
                  "weekdays",
                  "weekend",
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ],
                "examples": [
                  "daily"
                ],
                "description": "Days this schedule is active.",
                "title": "Days"
              }
            },
            "description": "When this schedule fires.",
            "title": "Trigger"
          },
