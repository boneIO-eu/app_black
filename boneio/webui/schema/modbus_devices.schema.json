{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "modbus_devices": {
      "description": "https://boneio.eu/docs/black/configuration/modbus-sensors \n List of modbus sensors. You can use predefined modbus sensors. It would fetch data from them and publish to mqtt.",
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "description": "Display Name",
            "title": "Name"
          },
          "area": {
            "type": "string",
            "description": "Area",
            "title": "Area"
          },
          "id": {
            "type": "string",
            "description": "Device ID",
            "title": "Id"
          },
          "address": {
            "description": "Address of Modbus sensor to use.",
            "type": [
              "integer",
              "string"
            ],
            "title": "Address"
          },
          "model": {
            "description": "Model to load from database.",
            "type": "string",
            "title": "Model"
          },
          "update_interval": {
            "default": "30s",
            "description": "Update interval (minimum 1 second).",
            "minimum": 1000,
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "title": "Update interval"
          },
          "entity_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": [
              "object",
              "string"
            ],
            "description": "Custom entity labels",
            "title": "Entity labels"
          },
          "sensors_filters": {
            "properties": {
              "temperature": {
                "default": [
                  {
                    "round": 2
                  }
                ],
                "description": "List of filters to apply. Allowed filters visible in allowed section.",
                "items": {
                  "additionalProperties": true,
                  "propertyNames": {
                    "enum": [
                      "offset",
                      "round",
                      "multiply",
                      "filter_out",
                      "filter_out_greater",
                      "filter_out_lower"
                    ]
                  },
                  "type": [
                    "object",
                    "string"
                  ]
                },
                "type": [
                  "array",
                  "string"
                ],
                "title": "Temperature"
              },
              "humidity": {
                "default": [
                  {
                    "round": 2
                  }
                ],
                "description": "List of filters to apply. Allowed filters visible in allowed section.",
                "items": {
                  "additionalProperties": true,
                  "propertyNames": {
                    "enum": [
                      "offset",
                      "round",
                      "multiply",
                      "filter_out",
                      "filter_out_greater",
                      "filter_out_lower"
                    ]
                  },
                  "type": [
                    "object",
                    "string"
                  ]
                },
                "type": [
                  "array",
                  "string"
                ],
                "title": "Humidity"
              }
            },
            "type": [
              "object",
              "string"
            ],
            "description": "List of sub sensors to use to filter. Available values are temperature or humidity. Only for CWT model.",
            "x-dependencies": {
              "model": [
                "cwt"
              ]
            },
            "title": "Sensors filters"
          },
          "data": {
            "properties": {
              "width": {
                "description": "Width of sensor in meters, cm etc. Without unit is meters",
                "type": [
                  "integer",
                  "number",
                  "string"
                ],
                "title": "Width"
              },
              "length": {
                "description": "Length of sensor in meters, cm etc. Without unit is meters",
                "type": [
                  "integer",
                  "number",
                  "string"
                ],
                "title": "Length"
              }
            },
            "type": [
              "object",
              "string"
            ],
            "description": "Data to pass to additional entities. Only for liquid-sensor model.",
            "x-dependencies": {
              "model": [
                "liquid-sensor"
              ]
            },
            "title": "Data"
          }
        },
        "required": [
          "address",
          "model"
        ],
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Modbus devices"
    }
  }
}