{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "modbus_devices": {
      "description": "https://boneio.eu/docs/black/configuration/modbus-sensors \n List of modbus sensors. You can use predefined modbus sensors. It would fetch data from them and publish to mqtt.",
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "description": "Display Name",
            "markdownDescription": "Display Name\n\nOptional friendly name shown in Home Assistant. If not set, uses id.",
            "title": "Name"
          },
          "area": {
            "type": "string",
            "description": "Area",
            "markdownDescription": "Area\n\nArea/room where the device is located. Used for grouping in Home Assistant.",
            "title": "Area"
          },
          "id": {
            "type": "string",
            "description": "Device ID",
            "markdownDescription": "Device ID\n\nTechnical identifier used in MQTT topics.\nMust contain only lowercase letters, numbers and underscores (no spaces).\nIf not set, auto-generated from address and model (e.g., 1_sdm120).",
            "title": "Id"
          },
          "address": {
            "description": "Address of Modbus sensor to use.",
            "type": [
              "integer",
              "string"
            ],
            "title": "Address"
          },
          "model": {
            "description": "Model to load from database.",
            "type": "string",
            "title": "Model"
          },
          "update_interval": {
            "default": "30s",
            "description": "Update interval (minimum 1 second).",
            "minimum": 1000,
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "title": "Update interval"
          },
          "entity_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": [
              "object",
              "string"
            ],
            "description": "Custom entity labels",
            "markdownDescription": "Custom entity labels\n\nMap of sensor decoded_name to custom display label.\nKeys are lowercase sensor names without spaces (e.g. humidity, temperature).\nValues are custom labels shown in UI and Home Assistant.\nExample: { humidity: \"Wilgotno\u015b\u0107 salon\", temperature: \"Temperatura salon\" }",
            "title": "Entity labels"
          },
          "entity_visibility": {
            "additionalProperties": {
              "description": "Where a Modbus entity shows; None keeps the device definition's choice.",
              "properties": {
                "panel": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "true",
                        "false",
                        "on",
                        "off"
                      ],
                      "x-yaml-boolean": true
                    }
                  ]
                },
                "ha": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "true",
                        "false",
                        "on",
                        "off"
                      ],
                      "x-yaml-boolean": true
                    }
                  ]
                }
              },
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "object",
              "string"
            ],
            "description": "Per entity: show it in the panel and in Home Assistant, or hide it. Without an entry the device definition decides.",
            "title": "Entity visibility"
          },
          "read_only": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": false,
            "description": "Read only: nothing is written to the device and Home Assistant gets no controls. Use it the first time you connect a device whose register map you have not checked.",
            "title": "Read only"
          },
          "sensors_filters": {
            "properties": {
              "temperature": {
                "default": [
                  {
                    "round": 2
                  }
                ],
                "description": "List of filters to apply. Allowed filters visible in allowed section.",
                "items": {
                  "additionalProperties": true,
                  "propertyNames": {
                    "enum": [
                      "offset",
                      "round",
                      "multiply",
                      "filter_out",
                      "filter_out_greater",
                      "filter_out_lower"
                    ]
                  },
                  "type": [
                    "object",
                    "string"
                  ]
                },
                "type": [
                  "array",
                  "string"
                ],
                "title": "Temperature"
              },
              "humidity": {
                "default": [
                  {
                    "round": 2
                  }
                ],
                "description": "List of filters to apply. Allowed filters visible in allowed section.",
                "items": {
                  "additionalProperties": true,
                  "propertyNames": {
                    "enum": [
                      "offset",
                      "round",
                      "multiply",
                      "filter_out",
                      "filter_out_greater",
                      "filter_out_lower"
                    ]
                  },
                  "type": [
                    "object",
                    "string"
                  ]
                },
                "type": [
                  "array",
                  "string"
                ],
                "title": "Humidity"
              }
            },
            "type": [
              "object",
              "string"
            ],
            "description": "List of sub sensors to use to filter. Available values are temperature or humidity. Only for CWT model.",
            "x-dependencies": {
              "model": [
                "cwt"
              ]
            },
            "title": "Sensors filters"
          },
          "data": {
            "properties": {
              "width": {
                "description": "Width of sensor in meters, cm etc. Without unit is meters",
                "type": [
                  "integer",
                  "number",
                  "string"
                ],
                "title": "Width"
              },
              "length": {
                "description": "Length of sensor in meters, cm etc. Without unit is meters",
                "type": [
                  "integer",
                  "number",
                  "string"
                ],
                "title": "Length"
              }
            },
            "type": [
              "object",
              "string"
            ],
            "description": "Data to pass to additional entities. Only for liquid-sensor model.",
            "x-dependencies": {
              "model": [
                "liquid-sensor"
              ]
            },
            "title": "Data"
          }
        },
        "required": [
          "address",
          "model"
        ],
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Modbus devices"
    }
  }
}