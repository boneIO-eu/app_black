{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "virtual_energy_sensor": {
      "description": "Virtual energy/water sensors linked to outputs. Creates power/energy or flow/volume sensors in Home Assistant.",
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Sensor ID",
            "title": "Id"
          },
          "name": {
            "description": "Sensor Name",
            "type": "string",
            "title": "Name"
          },
          "output_id": {
            "description": "Output ID",
            "type": "string",
            "title": "Output id"
          },
          "sensor_type": {
            "description": "Sensor Type",
            "enum": [
              "power",
              "water"
            ],
            "type": "string",
            "title": "Sensor type"
          },
          "power_usage": {
            "description": "Power Usage",
            "x-dependencies": {
              "sensor_type": [
                "power"
              ]
            },
            "type": [
              "integer",
              "number",
              "string"
            ],
            "title": "Power usage"
          },
          "flow_rate": {
            "description": "Flow Rate",
            "x-dependencies": {
              "sensor_type": [
                "water"
              ]
            },
            "type": [
              "integer",
              "number",
              "string"
            ],
            "title": "Flow rate"
          },
          "area": {
            "type": "string",
            "description": "Area",
            "title": "Area"
          }
        },
        "required": [
          "name",
          "output_id",
          "sensor_type"
        ],
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Virtual energy sensor"
    }
  }
}