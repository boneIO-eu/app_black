{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "adc": {
      "description": "https://boneio.eu/docs/black/configuration/adc \n GPIO ADC section of boneIO Black. It enables ADC sensors in HA. Don't let them hang without use.",
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name for the sensor in Home Assistant.",
            "title": "Name"
          },
          "id": {
            "type": "string",
            "description": "Id to use for MQTT topic. Default to name or pin number.",
            "title": "Id"
          },
          "pin": {
            "description": "PIN to use.",
            "enum": [
              "P9_33",
              "P9_35",
              "P9_36",
              "P9_37",
              "P9_38",
              "P9_39",
              "P9_40"
            ],
            "type": "string",
            "title": "Pin"
          },
          "area": {
            "type": "string",
            "description": "Area/Room",
            "title": "Area"
          },
          "update_interval": {
            "default": "60s",
            "description": "Update interval. How often to fetch data from sensor. Default to 60s.",
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "title": "Update interval"
          },
          "show_in_ha": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": true,
            "description": "If you want you can disable discovering this input in HA.",
            "title": "Show in ha"
          },
          "filters": {
            "default": [
              {
                "multiply": 1.8
              },
              {
                "round": 2
              }
            ],
            "description": "List of filters to apply. Allowed filters visible in allowed section.",
            "items": {
              "additionalProperties": true,
              "propertyNames": {
                "enum": [
                  "offset",
                  "round",
                  "multiply",
                  "filter_out",
                  "filter_out_greater",
                  "filter_out_lower"
                ]
              },
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "array",
              "string"
            ],
            "title": "Filters"
          }
        },
        "required": [
          "pin"
        ],
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Adc"
    }
  }
}