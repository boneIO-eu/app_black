{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lox_udp": {
      "properties": {
        "enabled": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "true",
                "false",
                "on",
                "off"
              ],
              "x-yaml-boolean": true
            }
          ],
          "default": false,
          "description": "Enable Lox UDP protocol",
          "title": "Enabled"
        },
        "host": {
          "description": "Target host",
          "pattern": "^(((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)*[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)$",
          "type": "string",
          "title": "Host"
        },
        "send_port": {
          "default": 4444,
          "description": "Port to send UDP messages",
          "type": [
            "integer",
            "string"
          ],
          "title": "Send port"
        },
        "listen_port": {
          "default": 4445,
          "description": "Port to listen for incoming UDP messages",
          "type": [
            "integer",
            "string"
          ],
          "title": "Listen port"
        }
      },
      "required": [
        "host"
      ],
      "type": [
        "object",
        "string"
      ],
      "description": "Lox UDP Messaging",
      "title": "Lox udp"
    }
  }
}