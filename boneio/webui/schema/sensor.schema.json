{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sensor": {
      "description": "Sensor list for Dallas 1-Wire temperature sensors (DS18B20, etc.). Detected via kernel w1 subsystem.",
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Id to use in HA if needed. Default to address.",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "description": "Display name for the sensor in Home Assistant.",
            "title": "Name"
          },
          "area": {
            "type": "string",
            "description": "Area/room where the sensor is located. Used for HA device grouping.",
            "title": "Area"
          },
          "address": {
            "description": "Address of Dallas device, as the kernel names it (28-0000098c7df0) or as ESPHome writes it (0xc0000000053f3328)",
            "type": "string",
            "title": "Address"
          },
          "show_in_ha": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "default": true,
            "description": "If you want you can disable discovering this input in HA.",
            "title": "Show in ha"
          },
          "filters": {
            "default": [
              {
                "round": 2
              }
            ],
            "description": "List of filters to apply. Allowed filters visible in allowed section.",
            "items": {
              "additionalProperties": true,
              "propertyNames": {
                "enum": [
                  "offset",
                  "round",
                  "multiply",
                  "filter_out",
                  "filter_out_greater",
                  "filter_out_lower"
                ]
              },
              "type": [
                "object",
                "string"
              ]
            },
            "type": [
              "array",
              "string"
            ],
            "title": "Filters"
          },
          "update_interval": {
            "default": "60s",
            "description": "Update interval. How often to fetch data from sensor. Default to 60s.",
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "title": "Update interval"
          },
          "unit_of_measurement": {
            "default": "\u00b0C",
            "enum": [
              "\u00b0C",
              "\u00b0F"
            ],
            "type": "string"
          }
        },
        "required": [
          "address"
        ],
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Sensor"
    }
  }
}