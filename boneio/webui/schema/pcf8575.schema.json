{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pcf8575": {
      "description": "https://boneio.eu/docs/black/configuration/pcf8575 \n PCF8575 Pin config. UNSTABLE.",
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of I2C to use in pin config",
            "title": "Id"
          },
          "address": {
            "description": "I2C address of the expander.",
            "type": [
              "integer",
              "string"
            ],
            "title": "Address"
          },
          "init_sleep": {
            "default": "0s",
            "description": "How long to sleep for PCF to initialize.",
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "title": "Init sleep"
          }
        },
        "required": [
          "address"
        ],
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Pcf8575"
    }
  }
}