{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mcp23017": {
      "description": "https://boneio.eu/docs/black/configuration/mcp23017 \n MCP23017 Pin config. All boneIO Black 32X10/Cover/Cover Mix/24x16 has two MCP23017 on board. If you use new boneio: section, then you don't need to define this.",
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of I2C to use in pin config",
            "title": "Id"
          },
          "address": {
            "description": "I2C address of the expander.",
            "type": [
              "integer",
              "string"
            ],
            "title": "Address"
          },
          "init_sleep": {
            "default": "0s",
            "description": "How long to sleep for MCP to initialize.",
            "type": [
              "number",
              "string"
            ],
            "x-timeperiod": true,
            "title": "Init sleep"
          },
          "inverted": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "true",
                  "false",
                  "on",
                  "off"
                ],
                "x-yaml-boolean": true
              }
            ],
            "description": "Active-LOW relay board (inverted logic)",
            "title": "Inverted"
          }
        },
        "required": [
          "address"
        ],
        "type": [
          "object",
          "string"
        ]
      },
      "type": [
        "array",
        "string"
      ],
      "title": "Mcp23017"
    }
  }
}