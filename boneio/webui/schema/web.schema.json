{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "web": {
      "type": [
        "null",
        "object",
        "string"
      ],
      "properties": {
        "port": {
          "type": [
            "integer",
            "string"
          ],
          "default": 8090,
          "description": "Port to run web server",
          "title": "Port"
        },
        "proxy_port": {
          "type": [
            "integer",
            "null",
            "string"
          ],
          "description": "Reverse proxy port for the Home Assistant link. Advanced; set it only when your own proxy fronts this panel on another port.",
          "title": "Proxy port"
        },
        "expose": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "proxy"
          ],
          "examples": [
            "all"
          ],
          "description": "Which addresses the panel answers on. 'all' serves it on every interface, including in the clear on the LAN. 'proxy' limits it to the loopback and the Docker bridge, so it is reachable over TLS on the proxy port or through an SSH tunnel, and not otherwise.",
          "title": "Expose"
        },
        "cloud": {
          "type": [
            "null",
            "object",
            "string"
          ],
          "default": {},
          "properties": {
            "enabled": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no",
                    "true",
                    "false",
                    "on",
                    "off"
                  ],
                  "x-yaml-boolean": true
                }
              ],
              "default": false,
              "description": "Enable cloud registration",
              "title": "Enabled"
            },
            "declined": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no",
                    "true",
                    "false",
                    "on",
                    "off"
                  ],
                  "x-yaml-boolean": true
                }
              ],
              "default": false,
              "description": "Not interested in cloud registration",
              "title": "Declined"
            },
            "pwa_name": {
              "type": [
                "null",
                "string"
              ],
              "description": "PWA short name",
              "title": "Pwa name"
            }
          },
          "description": "boneIO Cloud registration for PWA support",
          "title": "Cloud"
        },
        "security": {
          "type": [
            "null",
            "object",
            "string"
          ],
          "default": {},
          "properties": {
            "map_tiles": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no",
                    "true",
                    "false",
                    "on",
                    "off"
                  ],
                  "x-yaml-boolean": true
                }
              ],
              "default": false,
              "description": "Allow the location picker to load a map",
              "title": "Map tiles"
            },
            "frame_ancestors": {
              "type": [
                "array",
                "null",
                "string"
              ],
              "description": "Which sites may embed this panel in a frame",
              "title": "Frame ancestors"
            }
          },
          "description": "Web security headers",
          "title": "Security"
        },
        "auth": {
          "type": [
            "null",
            "object",
            "string"
          ],
          "default": {},
          "properties": {
            "username": {
              "type": "string",
              "description": "Username to connect to web interface",
              "title": "Username"
            },
            "password": {
              "type": "string",
              "description": "Password to web interface",
              "title": "Password"
            },
            "allow_anonymous": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no",
                    "true",
                    "false",
                    "on",
                    "off"
                  ],
                  "x-yaml-boolean": true
                }
              ],
              "default": false,
              "description": "Allow unauthenticated access to the web UI and API",
              "title": "Allow anonymous"
            }
          },
          "description": "Auth if defined",
          "title": "Auth"
        }
      },
      "description": "https://boneio.eu/docs/black/0.9.x-dev/configuration/web \n Web section of boneIO Black. It enables web interface. Default on port 8090.",
      "title": "Web"
    }
  }
}