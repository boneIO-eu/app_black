[Unit]
Description=boneIO
After=multi-user.target network.target boneio-oled-boot.service

[Service]
Type=simple
ExecStart=${BONEIO_HOME}/boneio/venv/bin/boneio run -c ${BONEIO_HOME}/boneio/config.yaml
ExecStopPost=/usr/sbin/oled_msg.sh "boneIO Black" "has stopped."
User=${BONEIO_USER}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
