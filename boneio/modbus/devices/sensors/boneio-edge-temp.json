{
    "model": "boneIO Edge Temp and Humidity sensor",
    "set_base": {
        "set_address_address": 100,
        "set_baudrate": {
            "address": 101,
            "possible_baudrates": {
                "2400": 0,
                "4800": 1,
                "9600": 2,
                "19200": 3
            }
        }
    },
    "registers_base": [
        {
            "base": 0,
            "length": 2,
            "register_type": "holding",
            "registers": [
                {
                    "name": "Humidity",
                    "address": 0,
                    "unit_of_measurement": "%",
                    "state_class": "measurement",
                    "device_class": "humidity",
                    "value_type": "S_WORD",
                    "filters": [
                        {
                            "multiply": 0.1
                        },
                        {
                            "round": 1
                        }
                    ]
                },
                {
                    "name": "Temperature",
                    "address": 1,
                    "unit_of_measurement": "°C",
                    "state_class": "measurement",
                    "device_class": "temperature",
                    "value_type": "S_WORD",
                    "filters": [
                        {
                            "multiply": 0.1
                        },
                        {
                            "round": 1
                        }
                    ]
                }
            ]
        },
        {
            "base": 102,
            "length": 1,
            "register_type": "holding",
            "update_every_n": 60,
            "registers": [
                {
                    "name": "LED Mode",
                    "address": 102,
                    "write_address": 102,
                    "entity_type": "writeable_sensor_discrete",
                    "state_class": "measurement",
                    "value_type": "U_WORD",
                    "x_mapping": {
                        "0": "off",
                        "1": "on",
                        "2": "beacon",
                        "3": "auto"
                    }
                }
            ]
        },
        {
            "base": 103,
            "length": 1,
            "register_type": "holding",
            "update_every_n": 1440,
            "registers": [
                {
                    "name": "FW Version",
                    "address": 103,
                    "value_type": "U_WORD",
                    "ha_filter": null,
                    "filters": [
                        {"firmware_version": 0}
                    ]
                }
            ]
        }
    ],
    "additional_entities": [
        {
            "name": "LED Mode",
            "source": "ledmode",
            "entity_type": "select",
            "x_mapping": {
                "0": "off",
                "1": "on",
                "2": "beacon",
                "3": "auto"
            }
        }
    ]
}