{
  "model": "DYP-A12",
  "manufacturer": "DYP",
  "description": "DYP-A12 Ultrasonic distance/level sensor",
  "category": "sensors",
  "default_address": 1,
  "default_update_interval": "10s",
  "set_base": {
    "set_address_address": 512
  },
  "registers_base": [
    {
      "base": 256,
      "length": 3,
      "register_type": "holding",
      "registers": [
        {
          "name": "Distance",
          "address": 256,
          "unit_of_measurement": "mm",
          "state_class": "measurement",
          "device_class": "distance",
          "value_type": "U_WORD"
        },
        {
          "name": "Distance Realtime",
          "address": 257,
          "unit_of_measurement": "mm",
          "state_class": "measurement",
          "device_class": "distance",
          "value_type": "U_WORD"
        },
        {
          "name": "Temperature",
          "address": 258,
          "unit_of_measurement": "°C",
          "state_class": "measurement",
          "device_class": "temperature",
          "value_type": "S_WORD",
          "filters": [
            {
              "multiply": 0.1
            },
            {
              "round": 1
            }
          ]
        }
      ]
    }
  ]
}
