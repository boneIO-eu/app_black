{
  "model": "PT100 Modbus",
  "manufacturer": "Generic",
  "description": "PT100 RTD temperature transmitter to Modbus",
  "category": "sensors",
  "default_address": 1,
  "default_update_interval": "10s",
  "registers_base": [
    {
      "base": 1,
      "length": 1,
      "register_type": "holding",
      "registers": [
        {
          "name": "Temperature_PT100",
          "address": 1,
          "unit_of_measurement": "°C",
          "state_class": "measurement",
          "device_class": "temperature",
          "value_type": "S_WORD",
          "filters": [
            {
              "multiply": 0.1
            },
            {
              "round": 1
            }
          ]
        }
      ]
    }
  ]
}
