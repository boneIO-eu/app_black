{
	# Global options - no ACME, use internal CA for all sites
}

# HTTP -> HTTPS redirect
:80 {
	redir https://{host}{uri} permanent
}

# HTTPS catch-all with internal self-signed certificate
https:// {
	tls internal {
		on_demand
	}

	# Handle errors (502, 503, 504)
	handle_errors {
		@502-504 expression {err.status_code} >= 502 && {err.status_code} <= 504
		handle @502-504 {
			root * /srv
			rewrite * /502.html
			file_server
		}
	}

	# Node-RED status endpoint
	handle /nodered-status {
		header Content-Type application/json
		header X-NodeRed-Available "true"
		header Access-Control-Expose-Headers "X-NodeRed-Available"
		respond `{"available": true}` 200
	}

	# Node-RED reverse proxy
	handle /nodered/* {
		reverse_proxy node-red:1880 {
			header_up X-Forwarded-Proto {scheme}
			header_down X-NodeRed-Available "true"
		}
	}

	# BoneIO reverse proxy (default)
	handle {
		reverse_proxy host.docker.internal:8090 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
